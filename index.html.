<!DOCTYPE html><html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SKORM GOLD</title><style>
:root {
  --gold:#f5c542;
  --bg:#090d14;
  --panel:#172231;
  --text:#f4f6fb;
  --muted:#aab5c5;
