<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SKORM GOLD</title>
<style>
:root{--bg:#090d14;--panel:#141c28;--panel2:#1b2635;--gold:#f5c542;--text:#f4f6fb;--muted:#aab5c5;--line:#2b394c;--green:#42d392}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at top,#1c2a3a 0,#090d14 48%);color:var(--text);font:16px/1.45 Arial,sans-serif}
main{width:min(720px,100%);margin:auto;padding:22px 16px 36px}
header{text-align:center;padding:18px 8px 24px}
.logo{font-size:clamp(30px,8vw,48px);font-weight:900;letter-spacing:2px;color:var(--gold);text-shadow:0 2px 18px #f5c54244}
.tag{color:var(--muted);margin-top:4px}
.balance{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.card,.section{background:linear-gradient(145deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:18px;padding:18px}
.balance .card{text-align:center}
.label{color:var(--muted);font-size:13px}
.amount{font-size:30px;font-weight:800;color:var(--gold);margin-top:4px}
.section{margin:14px 0}
h2{font-size:19px;margin:0 0 8px}
p{margin:6px 0 12px;color:var(--muted)}
button{border:0;border-radius:12px;padding:14px 18px;font-size:16px;font-weight:800;cursor:pointer;background:var(--gold);color:#17130a;width:100%;min-height:48px}
button:disabled{opacity:.45;cursor:not-allowed}
.secondary{background:#26364b;color:var(--text);border:1px solid #3a4b62}
.wheel-area{display:flex;justify-content:center;align-items:center;padding:16px 0 20px;position:relative}
.wheel{width:min(78vw,290px);aspect-ratio:1;border-radius:50%;border:8px solid #dcae36;position:relative;overflow:hidden;
 background:conic-gradient(#f7c94b 0deg 36deg,#26364b 36deg 72deg,#e8ad2e 72deg 108deg,#34465e 108deg 144deg,#f7c94b 144deg 180deg,#26364b 180deg 216deg,#e8ad2e 216deg 252deg,#34465e 252deg 288deg,#f7c94b 288deg 324deg,#26364b 324deg 360deg);
 box-shadow:0 0 0 4px #5d4518,0 8px 24px #0009;transition:transform 4s cubic-bezier(.12,.75,.12,1)}
.wheel:after{content:"";position:absolute;inset:38%;border-radius:50%;background:radial-gradient(circle,#fff1ad,#d89a1d 65%,#68490d);border:4px solid #fff0b0;box-shadow:0 2px 8px #0008}
.wheel-number{position:absolute;left:50%;top:50%;font-weight:900;font-size:20px;color:#17130a;text-shadow:0 1px 2px #fff8;transform:translate(-50%,-50%);z-index:1}
.wheel-number:nth-child(1){transform:translate(-50%,-50%) rotate(0deg) translateY(-102px)}
.wheel-number:nth-child(2){transform:translate(-50%,-50%) rotate(36deg) translateY(-102px)}
.wheel-number:nth-child(3){transform:translate(-50%,-50%) rotate(72deg) translateY(-102px)}
.wheel-number:nth-child(4){transform:translate(-50%,-50%) rotate(108deg) translateY(-102px)}
.wheel-number:nth-child(5){transform:translate(-50%,-50%) rotate(144deg) translateY(-102px)}
.wheel-number:nth-child(6){transform:translate(-50%,-50%) rotate(180deg) translateY(-102px)}
.wheel-number:nth-child(7){transform:translate(-50%,-50%) rotate(216deg) translateY(-102px)}
.wheel-number:nth-child(8){transform:translate(-50%,-50%) rotate(252deg) translateY(-102px)}
.wheel-number:nth-child(9){transform:translate(-50%,-50%) rotate(288deg) translateY(-102px)}
.wheel-number:nth-child(10){transform:translate(-50%,-50%) rotate(324deg) translateY(-102px)}
.wheel-pointer{width:0;height:0;border-left:13px solid transparent;border-right:13px solid transparent;border-top:24px solid #fff1b7;position:absolute;top:3px;left:50%;transform:translateX(-50%);z-index:3;filter:drop-shadow(0 2px 3px #000)}
.game-brand{display:flex;align-items:center;justify-content:center;gap:12px;margin:0 auto 14px;padding:10px 14px;border:1px solid #5b4922;border-radius:16px;background:linear-gradient(120deg,#171e29,#302514);max-width:440px}
.game-art{width:62px;height:62px;flex:0 0 62px;border-radius:12px;overflow:hidden;background:linear-gradient(145deg,#b92b26,#161b27 60%,#d99e16);display:grid;place-items:center;border:2px solid #d9ae45}
.game-art svg{width:100%;height:100%}
.game-title{font-size:clamp(16px,4vw,21px);font-weight:900;color:#ffe08a;line-height:1.15;text-align:left}
.game-subtitle{font-size:11px;color:#c6ced8;margin-top:5px;text-align:left}
.brand-tag{display:inline-block;margin-top:5px;padding:3px 7px;border-radius:20px;background:#d9a82d;color:#17130a;font-size:10px;font-weight:900}
@media(max-width:390px){.wheel{width:250px}.wheel-number:nth-child(n){transform-origin:center center}.wheel-number{font-size:17px}}
.progress-wrap{height:13px;background:#273447;border-radius:99px;overflow:hidden;margin:12px 0}
.progress{height:100%;width:0;background:linear-gradient(90deg,#d99e16,#ffe27b);transition:width .12s}
.counter{font-size:22px;font-weight:800;color:var(--gold);text-align:center;margin:10px}
.goldbar{font-size:64px;text-align:center;cursor:pointer;user-select:none;filter:drop-shadow(0 5px 15px #f5c54233);padding:4px}
.goldbar:active{transform:scale(.94)}
input{width:100%;padding:14px;border-radius:11px;border:1px solid var(--line);background:#0d1420;color:var(--text);font-size:16px;margin:7px 0 12px}
.notice{font-size:13px;color:var(--muted);margin-top:10px}
.status{min-height:22px;color:var(--green);font-size:14px;margin-top:8px}
footer{text-align:center;padding:20px 8px 8px;color:var(--muted)}
footer a{display:inline-block;margin-top:10px;color:#17130a;background:var(--gold);padding:13px 20px;border-radius:12px;text-decoration:none;font-weight:800}
@media(max-width:390px){.roulette{grid-template-columns:repeat(5,1fr)}.roulette span{font-size:13px}}

.creator-twitch{display:flex;flex-direction:column;align-items:center;gap:5px;margin:10px auto 16px;text-align:center}
.creator-twitch a{display:flex;flex-direction:column;align-items:center;gap:5px;color:#c9a7ff;text-decoration:none;font-weight:800}
.twitch-mark{width:38px;height:38px;display:grid;place-items:center;border-radius:11px;background:#9146ff;box-shadow:0 4px 14px #9146ff55}
.twitch-mark svg{width:25px;height:25px;fill:#fff}
.creator-caption{font-size:11px;letter-spacing:.8px;text-transform:uppercase;color:#d5d9e2}
.creator-link{font-size:14px;color:#c9a7ff;text-decoration:underline;text-underline-offset:3px}
.creator-twitch a:hover{filter:brightness(1.15)}

</style>
</head>
<body>
<main>
<header>
  <div class="game-brand">
    <div class="game-art" aria-label="Иллюстрация в стиле Blood Strike">
      <svg viewBox="0 0 100 100" role="img" aria-hidden="true">
        <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f2c34b"/><stop offset="1" stop-color="#a51f25"/></linearGradient></defs>
        <path d="M8 82 25 25 43 43 58 10 92 82Z" fill="#111722" opacity=".8"/>
        <path d="M34 22 48 30 55 48 49 58 37 53 29 38Z" fill="url(#g)" stroke="#ffe59a" stroke-width="2"/>
        <path d="M43 48 69 37 76 42 51 58 48 78 39 78 41 59Z" fill="#d7dce4"/>
        <path d="M63 37 84 30 87 35 68 45Z" fill="#f3c64d"/>
        <path d="M20 85 80 85" stroke="#f4c64d" stroke-width="5" stroke-linecap="round"/>
      </svg>
    </div>
    <div>
      <div class="game-title">BLOOD STRIKE<br>БЕСПЛАТНОЕ ЗОЛОТО</div>
      <div class="game-subtitle">Награды для игрового сообщества</div>
      <span class="brand-tag">БЕСПЛАТНО</span>
    </div>
  </div>

  <div class="creator-twitch">
    <a href="https://www.twitch.tv/skorm5" target="_blank" rel="noopener noreferrer" aria-label="Twitch канал SKORM5">
      <span class="twitch-mark">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2 2 6v14h5v3h3l3-3h4l5-5V2H4zm16 12-3 3h-5l-3 3v-3H5V4h15v10zM11 7h2v6h-2V7zm5 0h2v6h-2V7z"/></svg>
      </span>
      <span class="creator-caption">Разработано стримером</span>
      <span class="creator-link">twitch.tv/skorm5</span>
    </a>
  </div>
  <div class="logo">SKORM GOLD</div>
  <div class="tag">Играй • Копи • Получай</div>
  <div class="notice">Фан-проект сообщества. Не является официальным сайтом Blood Strike.</div>
</header>

<div class="balance">
  <div class="card" style="grid-column:1/-1"><div class="label">ТВОЁ ЗОЛОТО</div><div class="amount" id="gold">0</div></div>
</div>

<section class="section">
  <h2>🎰 Ежедневная рулетка</h2>
  <p>Одна попытка в день. Выигрыш — от 2 до 10 золота.</p>
  <div class="wheel-area">
    <div class="wheel-pointer"></div>
    <div class="wheel" id="wheel" aria-label="Круглая вращающаяся рулетка">
      <span class="wheel-number">2</span><span class="wheel-number">3</span>
      <span class="wheel-number">4</span><span class="wheel-number">5</span>
      <span class="wheel-number">6</span><span class="wheel-number">7</span>
      <span class="wheel-number">8</span><span class="wheel-number">9</span>
      <span class="wheel-number">10</span><span class="wheel-number">⭐</span>
    </div>
  </div>
  <button id="spin">КРУТИТЬ РУЛЕТКУ</button>
  <div class="status" id="spinStatus" aria-live="polite"></div>
</section>

<section class="section">
  <h2>🥇 Добыча золота 999</h2>
  <p>Нажми на золотой слиток 999 раз, чтобы получить 1 золото. Награда доступна один раз в день.</p>
  <div class="goldbar" id="goldbar" role="button" tabindex="0" aria-label="Нажать на золотой слиток">🪙</div>
  <div class="counter"><span id="clicks">0</span> / 999</div>
  <div class="progress-wrap"><div class="progress" id="progress"></div></div>
  <button class="secondary" id="mine">НАЖАТЬ НА СЛИТОК</button>
  <div class="status" id="mineStatus" aria-live="polite"></div>
</section>

<section class="section">
  <h2>📤 Вывод золота</h2>
  <p>Минимальная сумма вывода — 100 золота. Укажи свой игровой ник и сумму.</p>
  <label for="playerNick" class="label">Игровой ник Blood Strike</label>
  <input id="playerNick" type="text" maxlength="40" placeholder="Введи свой игровой ник">
  <label for="withdrawAmount" class="label">Сумма вывода (золото)</label>
  <input id="withdrawAmount" type="number" min="100" step="1" placeholder="Минимум 100">
  <button id="withdraw">СОЗДАТЬ ЗАЯВКУ</button>
  <div class="status" id="withdrawStatus" aria-live="polite"></div>
  <div class="notice" style="margin-top:14px;padding:13px;border:1px solid var(--line);border-radius:12px;background:#0d1420">
    <strong style="color:var(--gold)">📸 Инструкция после вывода</strong><br>
    После нажатия «Создать заявку» сделай скриншот экрана. Отправь его по ссылке ниже и обязательно напиши вместе со скриншотом свой игровой ID Blood Strike:
    <br><a href="https://t.me/c/4325029856/606" target="_blank" rel="noopener" style="color:var(--gold);word-break:break-all">https://t.me/c/4325029856/606</a>
  </div>
  <div class="notice">Пока это демонстрационный режим: заявка не отправляется автоматически администратору. Списание сохраняется только в браузере этого устройства.</div>
</section>

<footer>
  <div>Новости и общение SKORM GOLD</div>
  <a href="https://t.me/skorm555" target="_blank" rel="noopener">ПЕРЕЙТИ В TELEGRAM</a>
  <div class="notice">SKORM GOLD</div>
</footer>
</main>
<script>
(function(){
  const key='skormGoldDemoV1';
  const today=()=>new Date().toLocaleDateString('en-CA');
  let state;
  try{state=JSON.parse(localStorage.getItem(key))||{};}catch(e){state={};}
  state.gold=Number.isFinite(state.gold)?state.gold:0;
  state.clicks=state.clickDate===today()?(Number(state.clicks)||0):0;
  function save(){localStorage.setItem(key,JSON.stringify(state));render();}
  function render(){
    document.getElementById('gold').textContent=state.gold;
        document.getElementById('clicks').textContent=state.clicks;
    document.getElementById('progress').style.width=(Math.min(state.clicks,999)/999*100)+'%';
    const spun=state.spinDate===today();
    document.getElementById('spin').disabled=spun;
    if(spun && !document.getElementById('spinStatus').textContent) document.getElementById('spinStatus').textContent='Сегодня попытка уже использована.';
    const mined=state.rewardDate===today();
    document.getElementById('mine').disabled=mined;
    if(mined && !document.getElementById('mineStatus').textContent) document.getElementById('mineStatus').textContent='Сегодняшняя монета уже получена.';
  }
  document.getElementById('spin').addEventListener('click',()=>{
    if(state.spinDate===today())return;
    const button=document.getElementById('spin');
    const wheel=document.getElementById('wheel');
    const win=Math.floor(Math.random()*9)+2;
    button.disabled=true;
    document.getElementById('spinStatus').textContent='Рулетка крутится...';
    const extraTurns=5+Math.floor(Math.random()*4);
    const stopAngle=Math.floor(Math.random()*360);
    wheel.style.transform='rotate('+(extraTurns*360+stopAngle)+'deg)';
    window.setTimeout(()=>{
      state.gold+=win;state.spinDate=today();save();
      document.getElementById('spinStatus').textContent='Поздравляем! Выигрыш: +'+win+' золота.';
    },4100);
  });
  function clickMine(){
    if(state.rewardDate===today())return;
    state.clickDate=today();
    state.clicks=Math.min(999,state.clicks+1);
    if(state.clicks>=999){
      state.gold+=1;state.rewardDate=today();
      document.getElementById('mineStatus').textContent='Готово! Начислено 1 золото. Возвращайся завтра.';
    }else{
      document.getElementById('mineStatus').textContent='Ещё '+(999-state.clicks)+' нажатий до награды.';
    }
    save();
  }
  document.getElementById('mine').addEventListener('click',clickMine);
  document.getElementById('goldbar').addEventListener('click',clickMine);
  document.getElementById('goldbar').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();clickMine();}});
  document.getElementById('withdraw').addEventListener('click',()=>{
    const nick=document.getElementById('playerNick').value.trim();
    const amount=Number(document.getElementById('withdrawAmount').value);
    const out=document.getElementById('withdrawStatus');
    if(!nick){out.textContent='Введи свой игровой ник.';return;}
    if(!Number.isInteger(amount)||amount<100){out.textContent='Минимальная сумма вывода — 100 золота.';return;}
    if(amount>state.gold){out.textContent='Недостаточно золота на балансе.';return;}
    state.gold-=amount;
    state.lastWithdrawal={nick:nick,amount:amount,date:new Date().toISOString(),status:'Ожидает проверки'};
    save();
    out.textContent='Заявка оформлена в этом браузере. Списано '+amount+' золота. Сделай скриншот и отправь его по ссылке ниже. Вместе со скриншотом обязательно укажи свой игровой ID Blood Strike.';
  });
  render();
})();
</script>
</body>
</html>